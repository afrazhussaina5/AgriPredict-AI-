# AgriPredict AI - backend environment template
#
# HOW TO USE (founder):
#   1. Copy this file and name the copy ".env"  (same folder: apps/api/.env)
#   2. Fill in values only when a phase asks you to.
#   3. ".env" is gitignored - it never gets committed.
#   4. NEVER paste .env contents into chat, screenshots, or docs.

# Phase 1 needs NO credentials at all. Phase 3 adds the database settings below.

# development | staging | production | test
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Secret used to sign session tokens (used from Phase 4 onward).
# REQUIRED (the app will refuse to start) when ENVIRONMENT=production.
# Generate a value locally with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Comma-separated browser origins allowed to call the API.
# Frontend dev server defaults are listed below.
CORS_ORIGINS_STR=http://localhost:5173,http://127.0.0.1:5173

# --- Phase 3: database -------------------------------------------------------
# Your Supabase connection string, using the asyncpg driver prefix.
# Supabase dashboard > Project Settings > Database > Connection string > URI.
#
# Format:  postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
#
# IMPORTANT:
#   * Leave this BLANK until you are ready to connect to a real database.
#   * Development runs fine with it empty (health checks still work).
#   * It becomes REQUIRED when ENVIRONMENT=staging or production.
#   * Fill it in ONLY in your local apps/api/.env - never in this template,
#     never in chat, never in a screenshot.
POSTGRES_DSN=

# Connection pool tuning. These defaults suit a small Supabase project.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10

# Set to true temporarily to see SQL. Never enable in production - parameter
# values can appear in the output.
DB_ECHO=false

# Isolated database used by the automated tests. Do NOT point this at Supabase.
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
# --- Phase 4: authentication --------------------------------------------------
# Access tokens expire after this many minutes. A new token is issued after each
# successful OTP verification instead of using long sessions.
ACCESS_TOKEN_TTL_MINUTES=60

# One-time code behaviour. The defaults are tuned for Indian mobile numbers.
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5

# SMS provider.
#   "mock" is DEVELOPMENT ONLY. It shows the code in the API response instead of
#   sending an SMS, and the app REFUSES TO START when ENVIRONMENT=production.
#   Replace it with a real provider name once you have implemented the adapter -
#   see docs/phases/phase_04_authentication.md section 6.
SMS_PROVIDER=mock
SMS_SENDER_ID=AGRIPD

# AgriPredict AI - Environment Configuration Example
# Copy this file to .env and configure your local credentials.
# NEVER commit .env to version control.

# =============================================================================
# DATABASE (PostgreSQL / Supabase)
# =============================================================================
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
POSTGRES_DSN=
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<configure-locally>
SUPABASE_SECRET_KEY=<configure-locally>
SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# =============================================================================
# GOVERNMENT MANDI API (Official Agmarknet / Data.gov.in)
# =============================================================================
MARKET_API_URL=https://www.data.gov.in/resource/variety-wise-daily-market-prices-data-commodity
MARKET_API_KEY=<configure-locally>

# =============================================================================
# GEOCODING & ROUTING PROVIDERS
# =============================================================================
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
NOMINATIM_USER_AGENT=AgriPredict-AI-Dev/1.0 (contact@example.com)

ROUTING_PROVIDER=osrm
ROUTING_API_KEY=
OSRM_BASE_URL=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=<generate-with-openssl-rand-hex-32>
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# CACHE & SYNC SETTINGS
# =============================================================================
REDIS_URL=
MARKET_SYNC_CRON=0 6 * * *
MARKET_SYNC_LOOKBACK_DAYS=7

# =============================================================================
# EXTERNAL SERVICE KEYS (Optional)
# =============================================================================
ORS_API_KEY=
MAPBOX_API_KEY=
GOOGLE_MAPS_API_KEY=